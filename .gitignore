# Runtime artefacts that must never be committed.
#
# Note: storage/cache/{bible,ratelimit} and storage/installed.lock were added to
# git before this file existed. Ignoring a path does not untrack it, so those
# already-committed files keep working; this only stops new ones being added.

/storage/installed.lock
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/og/
/storage/cache/ratelimit/
/storage/cache/bible/

# Backups hold the entire database, including password hashes and stored secrets.
# They must never be committed.
/storage/backups/

# Cron lock files (cli/sms_worker.php, cli/sms_maintenance.php, ...). Runtime state by
# definition: their contents are meaningless and they are recreated on the next run.
/storage/cache/*.lock

# Office lock files, created beside a document while it is open.
~$*

# WhatsApp bridge (unofficial, Phase 4.4).
#
# The paired session under storage/wa-bridge/ is the important one: those files are a live login
# for that WhatsApp number. The .htaccess that denies HTTP access to them IS tracked, so the deny
# rule ships with the code rather than being something each host has to remember.
/bridge/node_modules/
/bridge/auth/
/storage/wa-bridge/*
!/storage/wa-bridge/.htaccess
!/storage/wa-bridge/.gitkeep
