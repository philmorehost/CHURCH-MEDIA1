# The bridge is a localhost service, not a web endpoint. Nothing here should be served.
# Kept as defence in depth: the paired session normally lives in storage/wa-bridge/, but a
# custom WA_BRIDGE_AUTH_DIR could place it here.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
